# ────────────────────────────────────────────────────────────────────────────
# Hive CRM — environment template
# Copy to `.env` and fill in real values for your environment.
# ────────────────────────────────────────────────────────────────────────────

# Application
APP_NAME="Hive CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Rome
APP_URL=http://localhost

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT
APP_CURRENCY=EUR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (Postgres 16 via Sail)
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=hive_crm
DB_USERNAME=sail
DB_PASSWORD=secret

# Sessions / cache / queue (Redis-backed in dev & prod)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=hive

# Redis 7
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Filesystems — primary disk for app uploads
# Set to "s3" (Contabo) in production; "local" for dev convenience.
FILESYSTEM_DISK=local

# ────────────────────────────────────────────────────────────────────────────
# Mail — AWS SES
# Region: pick the SES region you have an identity in.
# NOTE: New SES accounts are sandboxed: only verified addresses can receive.
# Request production access in the SES console before launching campaigns.
# See docs/deploy.md for the production access checklist.
# ────────────────────────────────────────────────────────────────────────────
MAIL_MAILER=ses
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-south-1
AWS_SES_CONFIGURATION_SET=
AWS_SES_WEBHOOK_TOPIC_ARN=

# Unsubscribe link signing
APP_UNSUBSCRIBE_TTL_DAYS=365

# ────────────────────────────────────────────────────────────────────────────
# Contabo Object Storage (S3-compatible)
# IMPORTANT: must set use_path_style_endpoint=true and explicit endpoint.
# Used for: uploads (FILESYSTEM_DISK=s3) and nightly backups.
# ────────────────────────────────────────────────────────────────────────────
CONTABO_ACCESS_KEY_ID=
CONTABO_SECRET_ACCESS_KEY=
CONTABO_DEFAULT_REGION=eu-central-1
CONTABO_BUCKET=hive-crm
CONTABO_ENDPOINT=https://eu2.contabostorage.com
CONTABO_USE_PATH_STYLE_ENDPOINT=true

# Backup destination (defaults to "s3" disk pointed at Contabo)
BACKUP_DISK=s3
BACKUP_NOTIFICATION_EMAIL=

# ────────────────────────────────────────────────────────────────────────────
# Cal.com Cloud
# Generate an API key in Cal.com → Settings → Developer.
# Webhook secret is shared between Cal.com webhook config and this app.
# ────────────────────────────────────────────────────────────────────────────
CALCOM_API_BASE_URL=https://api.cal.com/v2
CALCOM_API_KEY=
CALCOM_WEBHOOK_SECRET=

# ────────────────────────────────────────────────────────────────────────────
# Reverse proxy (production)
# The prod stack runs behind an external `caddy-docker-proxy` instance that
# terminates TLS and routes by container label. `APP_HOSTNAME` is the
# Caddy vhost (= the cert subject); `TRUSTED_PROXIES=*` lets Laravel honour
# the edge's X-Forwarded-Proto so generated URLs and cookies use https.
# ACME email is configured ONCE on the caddy-docker-proxy stack itself,
# not here.
# ────────────────────────────────────────────────────────────────────────────
APP_HOSTNAME=hive-crm.example.com
TRUSTED_PROXIES=*

# Sail-only: host port forwards (avoid clashing with local services)
APP_PORT=80
VITE_PORT=5173
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"

# ────────────────────────────────────────────────────────────────────────────
# Fattura / FatturaPA — owner's fiscal identity (Cedente Prestatore).
# Required so the SdI-XML import can recognise outbound invoices issued
# by you. The codice_fiscale here MUST match what the SdI XML carries
# in CedentePrestatore/DatiAnagrafici/CodiceFiscale.
# ────────────────────────────────────────────────────────────────────────────
OWNER_CODICE_FISCALE=
OWNER_PARTITA_IVA=
OWNER_DENOMINAZIONE=
OWNER_REGIME_FISCALE=RF19
OWNER_NATURA_DEFAULT=N2.2
OWNER_SEDE_INDIRIZZO=
OWNER_SEDE_CIVICO=
OWNER_SEDE_CAP=
OWNER_SEDE_COMUNE=
OWNER_SEDE_PROVINCIA=
OWNER_SEDE_NAZIONE=IT
